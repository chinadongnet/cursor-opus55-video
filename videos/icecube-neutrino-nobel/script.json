  "scenes": [
    {
      "id": "s01",
      "lead": 1.6,
      "pause": 1.2,
      "text": "此刻，每一秒，都有数百亿个中微子，穿过你指甲盖大小的地方。它们穿过你的身体，穿过整个地球，却几乎什么也不碰。它是宇宙里最害羞的粒子。",
      "cues": { "count": "数百亿", "earth": "穿过整个地球", "shy": "最害羞的粒子" }
    },
    {
      "id": "s02",
      "pause": 1.2,
      "text": "2026年10月，诺贝尔物理学奖授予美国威斯康星大学的弗朗西斯·哈尔岑，表彰他对冰立方中微子天文台的决定性贡献，以及发现了来自宇宙深处的高能中微子。这是一个用南极的冰，抓住幽灵粒子的故事。",
      "cues": { "name": "弗朗西斯", "icecube": "冰立方中微子天文台", "story": "用南极的冰" }
    },
    {
      "id": "s03",
      "text": "为什么非要抓它？因为宇宙传来的信使，大多会在路上走样。光，会被尘埃和气体挡住；带电的宇宙射线，会被磁场掰弯，早已认不出来时的方向。只有中微子，不带电，几乎不受干扰，沿着直线一路飞来，指回它出发的地方。",
      "cues": { "light": "光，会被", "ray": "带电的宇宙射线", "nu": "只有中微子", "back": "指回它出发的地方" }
    },
    {
      "id": "s04",
      "text": "可也正因为它几乎不与物质发生作用，想抓住它，难得离谱。一个中微子，可以轻松穿透一光年厚的铅。要等到它恰好撞上一个原子核，探测器就必须足够大，大到要用立方公里来计算。",
      "cues": { "lead": "一光年厚的铅", "hit": "撞上一个原子核", "km": "立方公里" }
    },
    {
      "id": "s05",
      "text": "1988年，哈尔岑提出了一个大胆的想法：不必去造这么大的容器，地球上本来就有一块现成的，南极冰盖。那里的冰厚近三千米，干净、黑暗、地质稳定，没有地震。1992年，第一批光学传感器被放进了南极的冰里。",
      "cues": { "y1988": "1988年", "ice": "南极冰盖", "props": "干净、黑暗", "y1992": "1992年" }
    },
    {
      "id": "s06",
      "text": "往下一千五百米，冰在巨大的压力下挤走了气泡，变得透明得不可思议。一束光在里面能走上百米，几乎不被吸收。在这样的冰里，哪怕一丝微弱的闪光，也能被远处的眼睛看见。",
      "cues": { "deep": "一千五百米", "clear": "透明得不可思议", "hundred": "上百米", "eye": "远处的眼睛" }
    },
    {
      "id": "s07",
      "text": "于是，人们用热水在冰上钻出八十六个深孔，每个深达两千五百米，再沿着电缆，挂进一串串比篮球还大一圈的光学传感器。2011年，冰立方建成：五千一百六十只眼睛，嵌在一立方公里的冰里，静静等待。",
      "cues": { "holes": "八十六个深孔", "sensors": "一串串", "y2011": "2011年", "count": "五千一百六十只眼睛", "wait": "静静等待" }
    },
    {
      "id": "s08",
      "text": "偶尔，一个中微子撞上了冰中的原子核，撞出一个带电粒子。它在冰里跑得比光在冰中还快，就会拖出一道蓝色的光锥，叫作切伦科夫辐射。传感器依次被点亮，根据每一只亮起的先后和明暗，科学家就能反推出，中微子从哪个方向来，带着多少能量。",
      "cues": { "hit": "撞上了冰中的原子核", "fast": "跑得比光在冰中还快", "cone": "切伦科夫辐射", "seq": "传感器依次被点亮", "back": "反推出" }
    },
    {
      "id": "s09",
      "text": "2013年，冰立方第一次确认，有一批能量极高的中微子，来自太阳系之外。2017年，一个中微子把人们的目光，引向约四十亿光年外的一个耀变体。2022年，人们在近邻的星系NGC 1068里，找到了中微子发射的证据。2023年，人类第一次用中微子，看见了银河系。",
      "cues": { "y2013": "2013年", "y2017": "2017年", "y2022": "2022年", "y2023": "2023年" }
    },
    {
      "id": "s10",
      "text": "过去，我们主要用光来观察宇宙。后来，有了引力波。现在，中微子也加入了进来。它能穿过最浓密的尘埃，从黑洞周围、从宇宙最剧烈的地方，带回光无法带回的消息。",
      "cues": { "light": "用光来观察", "gw": "引力波", "nu": "中微子也加入了进来", "bh": "黑洞周围" }
    },
    {
      "id": "s11",
      "pause": 4.0,
      "text": "从一个看似疯狂的想法，到一座埋在冰里的望远镜，哈尔岑走了三十多年。如今，一立方公里的冰，正在倾听宇宙最安静的信使。",
      "cues": { "idea": "看似疯狂的想法", "scope": "埋在冰里的望远镜", "final": "一立方公里的冰" }
    }
  ]
}
