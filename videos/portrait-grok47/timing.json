 "captions": [
  {
   "text": "你一定见过这种人像",
   "start": 0.748,
   "dur": 1.743
  },
  {
   "text": "曝光准确",
   "start": 2.491,
   "dur": 1.118
  },
  {
   "text": "眼神有光",
   "start": 3.609,
   "dur": 1.069
  },
  {
   "text": "背景也虚化了",
   "start": 4.678,
   "dur": 1.717
  },
  {
   "text": "可你多看三秒",
   "start": 6.395,
   "dur": 1.382
  },
  {
   "text": "人是空的",
   "start": 7.777,
   "dur": 1.298
  },
  {
   "text": "技术全对，人不在",
   "start": 9.075,
   "dur": 2.2
  },
  {
   "text": "问题不在参数",
   "start": 11.275,
   "dur": 1.815
  },
  {
   "text": "人像里最贵的东西",
   "start": 13.09,
   "dur": 1.647
  },
  {
   "text": "从来不在相机里",
   "start": 14.737,
   "dur": 2.075
  },
  {
   "text": "快门记下的",
   "start": 18.28,
   "dur": 1.226
  },
  {
   "text": "不是五官",
   "start": 19.506,
   "dur": 1.034
  },
  {
   "text": "是那个人在那一秒对你的感受",
   "start": 20.54,
   "dur": 2.87
  },
  {
   "text": "被审视，被催促",
   "start": 23.41,
   "dur": 1.839
  },
  {
   "text": "被尊重",
   "start": 25.249,
   "dur": 0.878
  },
  {
   "text": "还是忽然忘了镜头",
   "start": 26.127,
   "dur": 1.574
  },
  {
   "text": "全写在脸上",
   "start": 27.701,
   "dur": 1.647
  },
  {
   "text": "你越想证明自己会拍",
   "start": 29.348,
   "dur": 2.079
  },
  {
   "text": "对方就越会表演",
   "start": 31.427,
   "dur": 1.887
  },
  {
   "text": "第一项技术",
   "start": 33.314,
   "dur": 1.142
  },
  {
   "text": "是让对方愿意放松下来",
   "start": 34.456,
   "dur": 2.332
  },
  {
   "text": "照片",
   "start": 36.788,
   "dur": 0.757
  },
  {
   "text": "是一段关系的证据",
   "start": 37.545,
   "dur": 2.175
  },
  {
   "text": "光不是口诀",
   "start": 40.868,
   "dur": 1.178
  },
  {
   "text": "是一种态度",
   "start": 42.046,
   "dur": 1.476
  },
  {
   "text": "顺光让人好看",
   "start": 43.522,
   "dur": 1.503
  },
  {
   "text": "侧光让人被理解",
   "start": 45.025,
   "dur": 1.911
  },
  {
   "text": "光源越大、离得越近",
   "start": 46.936,
   "dur": 2.043
  },
  {
   "text": "皮肤越柔",
   "start": 48.979,
   "dur": 1.094
  },
  {
   "text": "脸仍立体",
   "start": 50.073,
   "dur": 1.154
  },
  {
   "text": "光源越小、越远",
   "start": 51.227,
   "dur": 1.851
  },
  {
   "text": "性格越硬",
   "start": 53.078,
   "dur": 1.37
  },
  {
   "text": "别问哪种光正确",
   "start": 54.448,
   "dur": 1.995
  },
  {
   "text": "问自己",
   "start": 56.443,
   "dur": 0.926
  },
  {
   "text": "观众在零点三秒内",
   "start": 57.369,
   "dur": 1.814
  },
  {
   "text": "会怎么看这个人",
   "start": 59.183,
   "dur": 1.599
  },
  {
   "text": "光比一比一像商品",
   "start": 60.782,
   "dur": 1.851
  },
  {
   "text": "三比一像日常",
   "start": 62.633,
   "dur": 1.322
  },
  {
   "text": "八比一像戏剧",
   "start": 63.955,
   "dur": 1.977
  },
  {
   "text": "先决定你站多近",
   "start": 67.08,
   "dur": 1.611
  },
  {
   "text": "再选镜头",
   "start": 68.691,
   "dur": 1.428
  },
  {
   "text": "八十五毫米的秘密不是焦段",
   "start": 70.119,
   "dur": 2.416
  },
  {
   "text": "是大约两米",
   "start": 72.535,
   "dur": 1.214
  },
  {
   "text": "近到能说话",
   "start": 73.749,
   "dur": 1.118
  },
  {
   "text": "远到不侵犯",
   "start": 74.867,
   "dur": 1.466
  },
  {
   "text": "机位平视是平等",
   "start": 76.333,
   "dur": 1.659
  },
  {
   "text": "俯拍是削弱",
   "start": 77.992,
   "dur": 1.274
  },
  {
   "text": "微微仰一点",
   "start": 79.266,
   "dur": 1.141
  },
  {
   "text": "是把尊严还给对方",
   "start": 80.407,
   "dur": 2.02
  },
  {
   "text": "很多证件照像审讯",
   "start": 82.427,
   "dur": 1.899
  },
  {
   "text": "只因为灯在正前方",
   "start": 84.326,
   "dur": 1.731
  },
  {
   "text": "人被固定在椅子上",
   "start": 86.057,
   "dur": 2.271
  },
  {
   "text": "不要说笑一个",
   "start": 89.476,
   "dur": 1.621
  },
  {
   "text": "那句话调用的是社交面具",
   "start": 91.097,
   "dur": 2.644
  },
  {
   "text": "给对方一件事做",
   "start": 93.741,
   "dur": 1.586
  },
  {
   "text": "讲一件真正得意的事",
   "start": 95.327,
   "dur": 1.815
  },
  {
   "text": "走到窗边",
   "start": 97.142,
   "dur": 1.094
  },
  {
   "text": "手里拿着自己的杯子",
   "start": 98.236,
   "dur": 2.104
  },
  {
   "text": "最好的表情",
   "start": 100.34,
   "dur": 1.201
  },
  {
   "text": "在笑出来的前一秒",
   "start": 101.541,
   "dur": 1.671
  },
  {
   "text": "也在话讲完之后的两秒沉默里",
   "start": 103.212,
   "dur": 2.572
  },
  {
   "text": "面具还没戴回去",
   "start": 105.784,
   "dur": 1.839
  },
  {
   "text": "手也别摆成目录",
   "start": 107.623,
   "dur": 1.563
  },
  {
   "text": "给手一个工作。脸",
   "start": 109.186,
   "dur": 2.103
  },
  {
   "text": "比手更会撒谎",
   "start": 111.289,
   "dur": 2.003
  },
  {
   "text": "背景不是用来虚掉的",
   "start": 114.44,
   "dur": 1.935
  },
  {
   "text": "它是第二个被摄者",
   "start": 116.375,
   "dur": 1.837
  },
  {
   "text": "人和他所在的世界",
   "start": 118.212,
   "dur": 1.767
  },
  {
   "text": "才是肖像的另一半",
   "start": 119.979,
   "dur": 1.971
  },
  {
   "text": "裁切就是论点",
   "start": 121.95,
   "dur": 1.442
  },
  {
   "text": "只留眼睛",
   "start": 123.392,
   "dur": 1.058
  },
  {
   "text": "拍的是心理",
   "start": 124.45,
   "dur": 1.298
  },
  {
   "text": "把人放回环境",
   "start": 125.748,
   "dur": 1.358
  },
  {
   "text": "拍的是身份",
   "start": 127.106,
   "dur": 1.479
  },
  {
   "text": "视线前方留出空白",
   "start": 128.585,
   "dur": 1.959
  },
  {
   "text": "念头才有地方落下",
   "start": 130.544,
   "dur": 2.031
  },
  {
   "text": "虚化只能分开层次",
   "start": 132.575,
   "dur": 1.875
  },
  {
   "text": "代替不了意义",
   "start": 134.45,
   "dur": 1.934
  },
  {
   "text": "信任",
   "start": 137.532,
   "dur": 0.769
  },
  {
   "text": "是测光表测不到的曝光",
   "start": 138.301,
   "dur": 2.342
  },
  {
   "text": "开拍之后",
   "start": 140.643,
   "dur": 1.034
  },
  {
   "text": "先让快门声变成熟悉的声音",
   "start": 141.677,
   "dur": 2.884
  },
  {
   "text": "早一点把一张好照片给对方看",
   "start": 144.561,
   "dur": 2.645
  },
  {
   "text": "难看的那张",
   "start": 147.206,
   "dur": 1.178
  },
  {
   "text": "永远留在自己手里",
   "start": 148.384,
   "dur": 1.935
  },
  {
   "text": "你问的问题",
   "start": 150.319,
   "dur": 1.129
  },
  {
   "text": "比你下的指令值钱",
   "start": 151.448,
   "dur": 2.008
  },
  {
   "text": "磨皮磨掉的常常不是瑕疵",
   "start": 153.456,
   "dur": 2.644
  },
  {
   "text": "是这个人活过的证据",
   "start": 156.1,
   "dur": 2.296
  },
  {
   "text": "下次别再加灯",
   "start": 159.544,
   "dur": 1.825
  },
  {
   "text": "只留一扇窗",
   "start": 161.369,
   "dur": 1.262
  },
  {
   "text": "或一盏灯",
   "start": 162.631,
   "dur": 1.286
  },
  {
   "text": "先站在能说话的距离",
   "start": 163.917,
   "dur": 1.875
  },
  {
   "text": "先聊天，再按快门",
   "start": 165.792,
   "dur": 2.308
  },
  {
   "text": "回家从一百张里只留三张",
   "start": 168.1,
   "dur": 2.416
  },
  {
   "text": "一张他忘记了镜头",
   "start": 170.516,
   "dur": 1.706
  },
  {
   "text": "一张手正在做事",
   "start": 172.222,
   "dur": 1.635
  },
  {
   "text": "一张环境在帮他说话",
   "start": 173.857,
   "dur": 2.248
  },
  {
   "text": "三张里如果没有一张让你心里一沉",
   "start": 176.105,
   "dur": 3.125
  },
  {
   "text": "你还没拍到人",
   "start": 179.23,
   "dur": 1.754
  },
  {
   "text": "器材决定你能不能拍清",
   "start": 182.262,
   "dur": 2.308
  },
  {
   "text": "光线决定你能不能塑形",
   "start": 184.57,
   "dur": 2.534
  },
  {
   "text": "而你这个人",
   "start": 187.104,
   "dur": 1.142
  },
  {
   "text": "决定对方愿不愿意把真实的脸交给你",
   "start": 188.246,
   "dur": 3.329
  },
  {
   "text": "优秀的人像",
   "start": 191.575,
   "dur": 1.19
  },
  {
   "text": "不是一次完美的曝光",
   "start": 192.765,
   "dur": 2.019
  },
  {
   "text": "它是一次被允许的看见",
   "start": 194.784,
   "dur": 2.32
  },
  {
   "text": "下次举相机之前",
   "start": 197.104,
   "dur": 1.671
  },
  {
   "text": "先问自己",
   "start": 198.775,
   "dur": 1.105
  },
  {
   "text": "我有没有资格",
   "start": 199.88,
   "dur": 1.31
  },
  {
   "text": "被这个人信任",
   "start": 201.19,
   "dur": 1.816
  }
 ]
}