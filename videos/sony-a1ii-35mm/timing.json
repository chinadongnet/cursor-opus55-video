 "captions": [
  {
   "text": "很多人买A1二代",
   "start": 1.496,
   "dur": 1.401
  },
  {
   "text": "是为了每秒三十张的连拍",
   "start": 2.897,
   "dur": 2.184
  },
  {
   "text": "但它其实也是一台被低估的视频机",
   "start": 5.081,
   "dur": 2.627
  },
  {
   "text": "这一期",
   "start": 7.708,
   "dur": 0.787
  },
  {
   "text": "只用一支二百八十克的三十五毫米F1.8",
   "start": 8.495,
   "dur": 3.194
  },
  {
   "text": "把它的视频高级玩法",
   "start": 11.689,
   "dur": 1.551
  },
  {
   "text": "一次讲透",
   "start": 13.24,
   "dur": 1.658
  },
  {
   "text": "先说为什么是它",
   "start": 16.344,
   "dur": 1.686
  },
  {
   "text": "机身加镜头刚好一公斤出头",
   "start": 18.03,
   "dur": 2.605
  },
  {
   "text": "手持和上稳定器都轻松",
   "start": 20.635,
   "dur": 2.43
  },
  {
   "text": "最近对焦零点二二米",
   "start": 23.065,
   "dur": 1.505
  },
  {
   "text": "能贴近拍桌面和细节",
   "start": 24.57,
   "dur": 2.407
  },
  {
   "text": "九片圆形光圈",
   "start": 26.977,
   "dur": 1.551
  },
  {
   "text": "焦外柔和",
   "start": 28.528,
   "dur": 1.366
  },
  {
   "text": "最关键的是",
   "start": 29.894,
   "dur": 1.146
  },
  {
   "text": "它几乎没有呼吸效应",
   "start": 31.04,
   "dur": 1.62
  },
  {
   "text": "拉焦时画面只变化约百分之一",
   "start": 32.66,
   "dur": 2.627
  },
  {
   "text": "天生适合拍视频",
   "start": 35.287,
   "dur": 2.451
  },
  {
   "text": "第一个玩法",
   "start": 38.884,
   "dur": 1.135
  },
  {
   "text": "一支定焦",
   "start": 40.019,
   "dur": 1.076
  },
  {
   "text": "当变焦用",
   "start": 41.095,
   "dur": 1.235
  },
  {
   "text": "全画幅4K",
   "start": 42.33,
   "dur": 1.192
  },
  {
   "text": "是三十五毫米",
   "start": 43.522,
   "dur": 1.354
  },
  {
   "text": "切到Super 35",
   "start": 44.876,
   "dur": 1.516
  },
  {
   "text": "画面由5.8K超采样",
   "start": 46.392,
   "dur": 1.945
  },
  {
   "text": "等效五十二点五毫米",
   "start": 48.337,
   "dur": 1.435
  },
  {
   "text": "细节反而更好",
   "start": 49.772,
   "dur": 1.284
  },
  {
   "text": "再叠加清晰影像变焦",
   "start": 51.056,
   "dur": 1.679
  },
  {
   "text": "可以推到约七十九毫米",
   "start": 52.735,
   "dur": 1.956
  },
  {
   "text": "把它设到自定义键上",
   "start": 54.691,
   "dur": 1.782
  },
  {
   "text": "一按就换景别",
   "start": 56.473,
   "dur": 2.101
  },
  {
   "text": "第二个玩法",
   "start": 59.72,
   "dur": 1.019
  },
  {
   "text": "拍8K，交付4K",
   "start": 60.739,
   "dur": 2.276
  },
  {
   "text": "8K由8.6K超采样而来",
   "start": 63.015,
   "dur": 2.847
  },
  {
   "text": "裁成4K",
   "start": 65.862,
   "dur": 1.042
  },
  {
   "text": "等于白送两倍推近",
   "start": 66.904,
   "dur": 1.806
  },
  {
   "text": "采访时一条素材",
   "start": 68.71,
   "dur": 1.493
  },
  {
   "text": "后期就能剪出全景和近景两个机位",
   "start": 70.203,
   "dur": 2.905
  },
  {
   "text": "还能做平滑的数字推拉",
   "start": 73.108,
   "dur": 1.956
  },
  {
   "text": "代价是",
   "start": 75.064,
   "dur": 0.949
  },
  {
   "text": "8K只有30帧",
   "start": 76.013,
   "dur": 1.69
  },
  {
   "text": "卷帘更明显",
   "start": 77.703,
   "dur": 1.273
  },
  {
   "text": "室温下连续录制约一小时",
   "start": 78.976,
   "dur": 3.218
  },
  {
   "text": "第三个玩法",
   "start": 83.34,
   "dur": 1.239
  },
  {
   "text": "慢动作和甩镜头",
   "start": 84.579,
   "dur": 2.126
  },
  {
   "text": "4K可以拍到120帧",
   "start": 86.705,
   "dur": 2.048
  },
  {
   "text": "放慢五倍",
   "start": 88.753,
   "dur": 1.019
  },
  {
   "text": "画面只裁切约1.13倍",
   "start": 89.772,
   "dur": 2.106
  },
  {
   "text": "三十五毫米变成约四十毫米",
   "start": 91.878,
   "dur": 2.535
  },
  {
   "text": "全高清还能拍到240帧",
   "start": 94.413,
   "dur": 2.708
  },
  {
   "text": "堆栈式传感器读出极快",
   "start": 97.121,
   "dur": 2.026
  },
  {
   "text": "4K下卷帘约8毫秒",
   "start": 99.147,
   "dur": 2.106
  },
  {
   "text": "快速甩镜也不容易果冻",
   "start": 101.253,
   "dur": 2.049
  },
  {
   "text": "转场可以大胆地甩",
   "start": 103.302,
   "dur": 2.392
  },
  {
   "text": "第四个玩法",
   "start": 106.84,
   "dur": 1.065
  },
  {
   "text": "S-Log3",
   "start": 107.905,
   "dur": 1.351
  },
  {
   "text": "它的最低感光度是ISO 800",
   "start": 109.256,
   "dur": 2.546
  },
  {
   "text": "白天再开F1.8大光圈",
   "start": 111.802,
   "dur": 2.257
  },
  {
   "text": "一定过曝",
   "start": 114.059,
   "dur": 0.822
  },
  {
   "text": "所以要准备一片55毫米的可变ND",
   "start": 114.881,
   "dur": 3.009
  },
  {
   "text": "快门守住帧率的两倍",
   "start": 117.89,
   "dur": 1.794
  },
  {
   "text": "比如24帧用五十分之一秒",
   "start": 119.684,
   "dur": 2.731
  },
  {
   "text": "机身能导入16个LUT用来监看",
   "start": 122.415,
   "dur": 3.287
  },
  {
   "text": "不想调色",
   "start": 125.702,
   "dur": 0.857
  },
  {
   "text": "就直接用S-Cinetone",
   "start": 126.559,
   "dur": 1.655
  },
  {
   "text": "或新增的FL2、FL3胶片风格",
   "start": 128.214,
   "dur": 4.124
  },
  {
   "text": "第五个玩法",
   "start": 133.484,
   "dur": 0.961
  },
  {
   "text": "驯服F1.8的浅景深",
   "start": 134.445,
   "dur": 2.392
  },
  {
   "text": "在一米距离",
   "start": 136.837,
   "dur": 1.192
  },
  {
   "text": "景深只有约九厘米",
   "start": 138.029,
   "dur": 1.921
  },
  {
   "text": "焦点稍偏就会虚",
   "start": 139.95,
   "dur": 1.598
  },
  {
   "text": "打开对焦地图",
   "start": 141.548,
   "dur": 1.412
  },
  {
   "text": "能直接看到哪里是清晰的",
   "start": 142.96,
   "dur": 2.477
  },
  {
   "text": "实时识别对焦升级到了AF+",
   "start": 145.437,
   "dur": 3.136
  },
  {
   "text": "人群中被短暂遮挡",
   "start": 148.573,
   "dur": 1.702
  },
  {
   "text": "也能咬住同一个人",
   "start": 150.275,
   "dur": 1.608
  },
  {
   "text": "再把对焦过渡速度调慢、",
   "start": 151.883,
   "dur": 1.875
  },
  {
   "text": "主体切换灵敏度调低",
   "start": 153.758,
   "dur": 1.991
  },
  {
   "text": "焦点转移就会像跟焦员一样从容",
   "start": 155.749,
   "dur": 3.425
  },
  {
   "text": "第六个玩法",
   "start": 160.32,
   "dur": 1.192
  },
  {
   "text": "一个人",
   "start": 161.512,
   "dur": 0.868
  },
  {
   "text": "当一个剧组",
   "start": 162.38,
   "dur": 1.282
  },
  {
   "text": "动态增强防抖在光学防抖之上",
   "start": 163.662,
   "dur": 2.743
  },
  {
   "text": "再加约三成效果",
   "start": 166.405,
   "dur": 1.493
  },
  {
   "text": "边走边拍也稳",
   "start": 167.898,
   "dur": 1.84
  },
  {
   "text": "自动构图能识别主体、自动裁切跟随",
   "start": 169.738,
   "dur": 3.796
  },
  {
   "text": "固定机位也能拍出运镜感",
   "start": 173.534,
   "dur": 2.373
  },
  {
   "text": "追求极致",
   "start": 175.907,
   "dur": 1.007
  },
  {
   "text": "就关掉机身防抖",
   "start": 176.914,
   "dur": 1.539
  },
  {
   "text": "用陀螺仪数据在后期稳定",
   "start": 178.453,
   "dur": 2.373
  },
  {
   "text": "三十五毫米留出的裁切余量刚好够用",
   "start": 180.826,
   "dur": 3.864
  },
  {
   "text": "第七个玩法",
   "start": 185.836,
   "dur": 1.169
  },
  {
   "text": "把它接进专业流程",
   "start": 187.005,
   "dur": 1.941
  },
  {
   "text": "HDMI能输出16位RAW给外录机",
   "start": 188.946,
   "dur": 3.727
  },
  {
   "text": "机内可以同时录代理文件",
   "start": 192.673,
   "dur": 1.991
  },
  {
   "text": "剪辑更流畅",
   "start": 194.664,
   "dur": 1.551
  },
  {
   "text": "录完给片段打上OK、NG、KEEP标记",
   "start": 196.215,
   "dur": 3.958
  },
  {
   "text": "现场就完成粗筛",
   "start": 200.173,
   "dur": 1.852
  },
  {
   "text": "散热上",
   "start": 202.025,
   "dur": 0.903
  },
  {
   "text": "把自动关机温度设为高",
   "start": 202.928,
   "dur": 1.828
  },
  {
   "text": "4K高帧率实测能连续录八十多分钟",
   "start": 204.756,
   "dur": 3.794
  },
  {
   "text": "三十五毫米做主力",
   "start": 209.696,
   "dur": 1.725
  },
  {
   "text": "其他镜头只补它做不到的",
   "start": 211.421,
   "dur": 2.23
  },
  {
   "text": "二十毫米F1.8 G",
   "start": 213.651,
   "dur": 1.748
  },
  {
   "text": "补空间和环境",
   "start": 215.399,
   "dur": 1.331
  },
  {
   "text": "八十五毫米F1.8",
   "start": 216.73,
   "dur": 1.713
  },
  {
   "text": "补人像特写和压缩感",
   "start": 218.443,
   "dur": 1.967
  },
  {
   "text": "这两支都是67毫米口径",
   "start": 220.41,
   "dur": 2.28
  },
  {
   "text": "给三十五毫米配一个55转67的转接环",
   "start": 222.69,
   "dur": 3.415
  },
  {
   "text": "三支镜头就能共用一片可变ND",
   "start": 226.105,
   "dur": 3.353
  },
  {
   "text": "最后",
   "start": 230.604,
   "dur": 0.822
  },
  {
   "text": "把这些存进三个记忆档位",
   "start": 231.426,
   "dur": 2.195
  },
  {
   "text": "一档日常叙事",
   "start": 233.621,
   "dur": 1.239
  },
  {
   "text": "全画幅4K 24帧",
   "start": 234.86,
   "dur": 2.118
  },
  {
   "text": "S-Log3",
   "start": 236.978,
   "dur": 1.319
  },
  {
   "text": "二档慢动作",
   "start": 238.297,
   "dur": 1.158
  },
  {
   "text": "4K 120帧",
   "start": 239.455,
   "dur": 1.597
  },
  {
   "text": "快门二百五十分之一秒",
   "start": 241.052,
   "dur": 2.106
  },
  {
   "text": "三档采访",
   "start": 243.158,
   "dur": 1.054
  },
  {
   "text": "8K 24帧",
   "start": 244.212,
   "dur": 1.342
  },
  {
   "text": "留给后期二次构图",
   "start": 245.554,
   "dur": 1.933
  },
  {
   "text": "现场换场景",
   "start": 247.487,
   "dur": 1.296
  },
  {
   "text": "只要拨一下转盘",
   "start": 248.783,
   "dur": 2.135
  },
  {
   "text": "旗舰机真正的价值",
   "start": 252.064,
   "dur": 1.702
  },
  {
   "text": "不在于你背了多少支镜头",
   "start": 253.766,
   "dur": 2.349
  },
  {
   "text": "而在于一支镜头",
   "start": 256.115,
   "dur": 1.424
  },
  {
   "text": "就能拍出一整套镜头的画面",
   "start": 257.539,
   "dur": 2.815
  }
 ]
}