 "captions": [
  {
   "text": "晚上十一点",
   "start": 0.898,
   "dur": 1.298
  },
  {
   "text": "孩子房门缝里还透着屏幕的光",
   "start": 2.196,
   "dur": 2.967
  },
  {
   "text": "体检单上",
   "start": 5.163,
   "dur": 1.058
  },
  {
   "text": "近视又涨了一百度",
   "start": 6.221,
   "dur": 2.007
  },
  {
   "text": "你又急又气",
   "start": 8.228,
   "dur": 1.262
  },
  {
   "text": "一句“你还要不要眼睛了”脱口而出",
   "start": 9.49,
   "dur": 2.416
  },
  {
   "text": "门砰地关上",
   "start": 11.906,
   "dur": 1.478
  },
  {
   "text": "高一孩子游戏多、视力差",
   "start": 13.384,
   "dur": 2.356
  },
  {
   "text": "家长到底该怎么办？",
   "start": 15.74,
   "dur": 2.182
  },
  {
   "text": "先做一个关键判断",
   "start": 19.42,
   "dur": 1.755
  },
  {
   "text": "游戏和视力",
   "start": 21.175,
   "dur": 1.166
  },
  {
   "text": "是表面问题",
   "start": 22.341,
   "dur": 1.31
  },
  {
   "text": "亲子关系",
   "start": 23.651,
   "dur": 1.07
  },
  {
   "text": "才是根本。关系好",
   "start": 24.721,
   "dur": 2.233
  },
  {
   "text": "你的话他听得进",
   "start": 26.954,
   "dur": 1.37
  },
  {
   "text": "关系坏",
   "start": 28.324,
   "dur": 0.842
  },
  {
   "text": "再正确的道理",
   "start": 29.166,
   "dur": 1.226
  },
  {
   "text": "也只是唠叨",
   "start": 30.392,
   "dur": 1.43
  },
  {
   "text": "所以顺序很重要",
   "start": 31.822,
   "dur": 1.947
  },
  {
   "text": "先修关系",
   "start": 33.769,
   "dur": 1.07
  },
  {
   "text": "再谈规则",
   "start": 34.839,
   "dur": 1.07
  },
  {
   "text": "最后才是方法",
   "start": 35.909,
   "dur": 1.951
  },
  {
   "text": "修关系，先要理解",
   "start": 38.908,
   "dur": 2.055
  },
  {
   "text": "孩子为什么爱玩游戏？",
   "start": 40.963,
   "dur": 1.909
  },
  {
   "text": "心理学发现",
   "start": 42.872,
   "dur": 1.287
  },
  {
   "text": "人有三种基本需要",
   "start": 44.159,
   "dur": 1.682
  },
  {
   "text": "自主，自己说了算",
   "start": 45.841,
   "dur": 1.887
  },
  {
   "text": "胜任，觉得自己行",
   "start": 47.728,
   "dur": 1.755
  },
  {
   "text": "归属",
   "start": 49.483,
   "dur": 0.745
  },
  {
   "text": "有朋友、被认同",
   "start": 50.228,
   "dur": 2.104
  },
  {
   "text": "高一学业压力陡增",
   "start": 52.332,
   "dur": 1.815
  },
  {
   "text": "这些需要在现实中落空",
   "start": 54.147,
   "dur": 2.055
  },
  {
   "text": "孩子就会去游戏里找",
   "start": 56.202,
   "dur": 2.37
  },
  {
   "text": "所以",
   "start": 59.62,
   "dur": 0.829
  },
  {
   "text": "别只问“怎么让他不玩”",
   "start": 60.449,
   "dur": 1.779
  },
  {
   "text": "先问“他在游戏里得到了什么”",
   "start": 62.228,
   "dur": 2.498
  },
  {
   "text": "也要分清程度",
   "start": 64.726,
   "dur": 1.383
  },
  {
   "text": "时间偏多",
   "start": 66.109,
   "dur": 1.081
  },
  {
   "text": "但作息、成绩、社交基本正常",
   "start": 67.19,
   "dur": 3.029
  },
  {
   "text": "属于需要管理",
   "start": 70.219,
   "dur": 1.274
  },
  {
   "text": "如果失控已持续一年",
   "start": 71.493,
   "dur": 1.947
  },
  {
   "text": "严重影响睡眠和上学",
   "start": 73.44,
   "dur": 2.032
  },
  {
   "text": "一停就暴躁",
   "start": 75.472,
   "dur": 1.201
  },
  {
   "text": "就该寻求专业帮助",
   "start": 76.673,
   "dur": 2.323
  },
  {
   "text": "有三种做法",
   "start": 80.044,
   "dur": 1.286
  },
  {
   "text": "往往适得其反",
   "start": 81.33,
   "dur": 1.382
  },
  {
   "text": "没收、砸手机",
   "start": 82.712,
   "dur": 1.683
  },
  {
   "text": "换来对抗和偷偷玩",
   "start": 84.395,
   "dur": 1.743
  },
  {
   "text": "唠叨、翻旧账",
   "start": 86.138,
   "dur": 1.476
  },
  {
   "text": "让孩子关上耳朵",
   "start": 87.614,
   "dur": 1.671
  },
  {
   "text": "拿别人家孩子比较",
   "start": 89.285,
   "dur": 1.635
  },
  {
   "text": "伤的是自尊",
   "start": 90.92,
   "dur": 1.49
  },
  {
   "text": "十六岁的孩子正在长成大人",
   "start": 92.41,
   "dur": 2.62
  },
  {
   "text": "他最需要的",
   "start": 95.03,
   "dur": 1.142
  },
  {
   "text": "是被尊重",
   "start": 96.172,
   "dur": 1.592
  },
  {
   "text": "那该怎么谈？",
   "start": 98.812,
   "dur": 1.44
  },
  {
   "text": "试试三步：第一",
   "start": 100.252,
   "dur": 1.863
  },
  {
   "text": "挑双方都平静的时候",
   "start": 102.115,
   "dur": 2.104
  },
  {
   "text": "别在他打到一半时开口",
   "start": 104.219,
   "dur": 2.296
  },
  {
   "text": "第二，先听再说",
   "start": 106.515,
   "dur": 1.718
  },
  {
   "text": "问问他",
   "start": 108.233,
   "dur": 0.806
  },
  {
   "text": "这款游戏最吸引你的是什么？",
   "start": 109.039,
   "dur": 2.439
  },
  {
   "text": "第三",
   "start": 111.478,
   "dur": 0.806
  },
  {
   "text": "用“我”开头说感受",
   "start": 112.284,
   "dur": 1.49
  },
  {
   "text": "“我看到体检单",
   "start": 113.774,
   "dur": 1.322
  },
  {
   "text": "很担心你的眼睛”",
   "start": 115.096,
   "dur": 1.467
  },
  {
   "text": "而不是“你就知道玩”",
   "start": 116.563,
   "dur": 2.129
  },
  {
   "text": "谈开之后",
   "start": 119.74,
   "dur": 1.094
  },
  {
   "text": "和孩子一起定规则",
   "start": 120.834,
   "dur": 1.803
  },
  {
   "text": "而不是替他定",
   "start": 122.637,
   "dur": 1.572
  },
  {
   "text": "可以参考国家防沉迷规定",
   "start": 124.209,
   "dur": 2.416
  },
  {
   "text": "未成年人只能在周五到周日、节假日的",
   "start": 126.625,
   "dur": 3.293
  },
  {
   "text": "晚上八点到九点玩网游",
   "start": 129.918,
   "dur": 2.921
  },
  {
   "text": "上学日以休息为主",
   "start": 132.839,
   "dur": 1.959
  },
  {
   "text": "手机晚上十点半放到客厅充电",
   "start": 134.798,
   "dur": 3.113
  },
  {
   "text": "规则写下来",
   "start": 137.911,
   "dur": 1.226
  },
  {
   "text": "双方签字",
   "start": 139.137,
   "dur": 1.154
  },
  {
   "text": "做到了就给更多信任",
   "start": 140.291,
   "dur": 2.593
  },
  {
   "text": "再说视力",
   "start": 143.932,
   "dur": 1.44
  },
  {
   "text": "近视一旦形成",
   "start": 145.372,
   "dur": 1.395
  },
  {
   "text": "基本不可逆",
   "start": 146.767,
   "dur": 1.154
  },
  {
   "text": "但可以延缓加深",
   "start": 147.921,
   "dur": 1.875
  },
  {
   "text": "记住三个二十",
   "start": 149.796,
   "dur": 1.454
  },
  {
   "text": "近距离用眼二十分钟",
   "start": 151.25,
   "dur": 1.983
  },
  {
   "text": "就看六米外的远处二十秒",
   "start": 153.233,
   "dur": 2.584
  },
  {
   "text": "每天户外活动两小时",
   "start": 155.817,
   "dur": 1.935
  },
  {
   "text": "白天的自然光",
   "start": 157.752,
   "dur": 1.238
  },
  {
   "text": "是最好的护眼药",
   "start": 158.99,
   "dur": 1.767
  },
  {
   "text": "屏幕至少一臂远",
   "start": 160.757,
   "dur": 1.683
  },
  {
   "text": "别在黑暗里看手机",
   "start": 162.44,
   "dur": 2.26
  },
  {
   "text": "另外",
   "start": 165.748,
   "dur": 0.757
  },
  {
   "text": "带孩子去正规医院",
   "start": 166.505,
   "dur": 1.683
  },
  {
   "text": "做一次规范的验光和眼底检查",
   "start": 168.188,
   "dur": 2.788
  },
  {
   "text": "配一副合适的眼镜",
   "start": 170.976,
   "dur": 1.645
  },
  {
   "text": "之后每半年复查",
   "start": 172.621,
   "dur": 2.007
  },
  {
   "text": "角膜塑形镜、低浓度阿托品这些控制手段",
   "start": 174.628,
   "dur": 3.762
  },
  {
   "text": "要听医生的",
   "start": 178.39,
   "dur": 1.202
  },
  {
   "text": "别信偏方",
   "start": 179.592,
   "dur": 1.07
  },
  {
   "text": "也别指望一副眼镜一劳永逸",
   "start": 180.662,
   "dur": 3.19
  },
  {
   "text": "堵不如疏",
   "start": 184.9,
   "dur": 1.356
  },
  {
   "text": "孩子在游戏里追求的成就感和友谊",
   "start": 186.256,
   "dur": 3.065
  },
  {
   "text": "现实里也能找到",
   "start": 189.321,
   "dur": 1.623
  },
  {
   "text": "陪他打一场球",
   "start": 190.944,
   "dur": 1.286
  },
  {
   "text": "周末一起爬山",
   "start": 192.23,
   "dur": 1.49
  },
  {
   "text": "支持他加入社团",
   "start": 193.72,
   "dur": 1.995
  },
  {
   "text": "如果他真热爱游戏",
   "start": 195.715,
   "dur": 1.623
  },
  {
   "text": "就引导他去了解游戏设计和编程",
   "start": 197.338,
   "dur": 2.909
  },
  {
   "text": "把“玩游戏”变成“做游戏”",
   "start": 200.247,
   "dur": 2.733
  },
  {
   "text": "最难的一条",
   "start": 204.028,
   "dur": 1.118
  },
  {
   "text": "是家长先做到",
   "start": 205.146,
   "dur": 1.693
  },
  {
   "text": "你一边刷手机",
   "start": 206.839,
   "dur": 1.286
  },
  {
   "text": "一边让孩子放下手机",
   "start": 208.125,
   "dur": 1.767
  },
  {
   "text": "很难有说服力",
   "start": 209.892,
   "dur": 1.61
  },
  {
   "text": "不妨定一个全家无屏幕时间",
   "start": 211.502,
   "dur": 2.332
  },
  {
   "text": "比如晚饭后一小时",
   "start": 213.834,
   "dur": 1.634
  },
  {
   "text": "一起散步、聊天",
   "start": 215.468,
   "dur": 2.02
  },
  {
   "text": "孩子不会照你说的做",
   "start": 217.488,
   "dur": 1.815
  },
  {
   "text": "但会照你做的做",
   "start": 219.303,
   "dur": 2.109
  },
  {
   "text": "给你一份四周行动计划",
   "start": 222.46,
   "dur": 2.306
  },
  {
   "text": "第一周，只听不评",
   "start": 224.766,
   "dur": 1.779
  },
  {
   "text": "重建信任。第二周",
   "start": 226.545,
   "dur": 2.223
  },
  {
   "text": "坐下来",
   "start": 228.768,
   "dur": 0.818
  },
  {
   "text": "一起定规则",
   "start": 229.586,
   "dur": 1.562
  },
  {
   "text": "第三周",
   "start": 231.148,
   "dur": 0.853
  },
  {
   "text": "做一次眼科检查",
   "start": 232.001,
   "dur": 1.551
  },
  {
   "text": "安排好户外时间",
   "start": 233.552,
   "dur": 1.875
  },
  {
   "text": "第四周，复盘调整",
   "start": 235.427,
   "dur": 1.971
  },
  {
   "text": "看见孩子的每一点进步",
   "start": 237.398,
   "dur": 2.518
  },
  {
   "text": "改变不会一夜发生",
   "start": 241.114,
   "dur": 1.695
  },
  {
   "text": "有反复，很正常",
   "start": 242.809,
   "dur": 2.149
  },
  {
   "text": "请记住",
   "start": 244.958,
   "dur": 1.034
  },
  {
   "text": "你和孩子从来不是对手",
   "start": 245.992,
   "dur": 1.971
  },
  {
   "text": "而是站在同一边、一起面对问题的队友",
   "start": 247.963,
   "dur": 3.606
  },
  {
   "text": "先修关系",
   "start": 251.569,
   "dur": 1.142
  },
  {
   "text": "再谈规则",
   "start": 252.711,
   "dur": 1.202
  },
  {
   "text": "关系通了",
   "start": 253.913,
   "dur": 0.961
  },
  {
   "text": "成长的路就通了",
   "start": 254.874,
   "dur": 2.088
  }
 ]
}