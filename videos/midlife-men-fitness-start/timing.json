 "captions": [
  {
   "text": "快四十岁",
   "start": 0.898,
   "dur": 1.178
  },
  {
   "text": "决定开始锻炼",
   "start": 2.076,
   "dur": 1.37
  },
  {
   "text": "这是好事",
   "start": 3.446,
   "dur": 1.248
  },
  {
   "text": "但很多人倒在了第一个月",
   "start": 4.694,
   "dur": 1.767
  },
  {
   "text": "跑了两周，膝盖疼",
   "start": 6.461,
   "dur": 2.019
  },
  {
   "text": "打了一次球",
   "start": 8.48,
   "dur": 1.082
  },
  {
   "text": "肩膀拉伤",
   "start": 9.562,
   "dur": 1.178
  },
  {
   "text": "然后彻底放弃",
   "start": 10.74,
   "dur": 1.647
  },
  {
   "text": "今天",
   "start": 12.387,
   "dur": 0.997
  },
  {
   "text": "我们把从零开始锻炼这件事讲清楚",
   "start": 13.384,
   "dur": 3.674
  },
  {
   "text": "第一步不是买装备",
   "start": 18.756,
   "dur": 1.683
  },
  {
   "text": "而是体检。量血压",
   "start": 20.439,
   "dur": 2.33
  },
  {
   "text": "查血糖血脂",
   "start": 22.769,
   "dur": 1.49
  },
  {
   "text": "做个心电图",
   "start": 24.259,
   "dur": 1.514
  },
  {
   "text": "如果你血压偏高、经常胸闷",
   "start": 25.773,
   "dur": 2.452
  },
  {
   "text": "或者家里有人很早就得了心脏病",
   "start": 28.225,
   "dur": 2.14
  },
  {
   "text": "先问医生再运动",
   "start": 30.365,
   "dur": 1.682
  },
  {
   "text": "运动时一旦胸口发紧、左臂或下巴放射痛、",
   "start": 32.047,
   "dur": 4.039
  },
  {
   "text": "异常气短",
   "start": 36.086,
   "dur": 1.058
  },
  {
   "text": "立刻停下，别硬扛",
   "start": 37.144,
   "dur": 2.74
  },
  {
   "text": "要不要请教练？",
   "start": 40.932,
   "dur": 1.464
  },
  {
   "text": "建议是",
   "start": 42.396,
   "dur": 0.926
  },
  {
   "text": "花钱买动作",
   "start": 43.322,
   "dur": 1.298
  },
  {
   "text": "而不是买陪练",
   "start": 44.62,
   "dur": 1.49
  },
  {
   "text": "前期上八到十二节课",
   "start": 46.11,
   "dur": 1.9
  },
  {
   "text": "学会深蹲、硬拉、俯卧撑这些基本动作",
   "start": 48.01,
   "dur": 3.942
  },
  {
   "text": "学会热身和发力",
   "start": 51.952,
   "dur": 1.562
  },
  {
   "text": "之后就能自己练",
   "start": 53.514,
   "dur": 1.587
  },
  {
   "text": "好教练会先问你的伤病史和目标",
   "start": 55.101,
   "dur": 3.017
  },
  {
   "text": "做体态评估",
   "start": 58.118,
   "dur": 1.141
  },
  {
   "text": "计划循序渐进",
   "start": 59.259,
   "dur": 1.755
  },
  {
   "text": "一上来就推销大课包、让你练到吐的",
   "start": 61.014,
   "dur": 2.993
  },
  {
   "text": "直接换人",
   "start": 64.007,
   "dur": 1.989
  },
  {
   "text": "中年人最该补的",
   "start": 67.044,
   "dur": 1.635
  },
  {
   "text": "是力量",
   "start": 68.679,
   "dur": 1.152
  },
  {
   "text": "肌肉就是关节的减震器",
   "start": 69.831,
   "dur": 2.476
  },
  {
   "text": "每周两到三次",
   "start": 72.307,
   "dur": 1.61
  },
  {
   "text": "重点练臀腿、核心、后背和肩袖",
   "start": 73.917,
   "dur": 3.93
  },
  {
   "text": "臀部和核心够稳",
   "start": 77.847,
   "dur": 1.659
  },
  {
   "text": "跑步时膝盖才不会内扣",
   "start": 79.506,
   "dur": 2.524
  },
  {
   "text": "先打四到八周底子",
   "start": 82.03,
   "dur": 1.731
  },
  {
   "text": "再上跑步和对抗类球赛",
   "start": 83.761,
   "dur": 2.055
  },
  {
   "text": "受伤会少很多",
   "start": 85.816,
   "dur": 2.476
  },
  {
   "text": "跑步伤膝",
   "start": 89.34,
   "dur": 1.058
  },
  {
   "text": "多半不是跑步的错",
   "start": 90.398,
   "dur": 1.538
  },
  {
   "text": "而是跑法的错",
   "start": 91.936,
   "dur": 1.453
  },
  {
   "text": "第一",
   "start": 93.389,
   "dur": 0.745
  },
  {
   "text": "从走跑结合开始",
   "start": 94.134,
   "dur": 1.659
  },
  {
   "text": "跑一分钟",
   "start": 95.793,
   "dur": 0.853
  },
  {
   "text": "走两分钟。第二",
   "start": 96.646,
   "dur": 2.079
  },
  {
   "text": "慢到能说完整句子",
   "start": 98.725,
   "dur": 1.827
  },
  {
   "text": "第三",
   "start": 100.552,
   "dur": 0.757
  },
  {
   "text": "步子小一点、步频快一点",
   "start": 101.309,
   "dur": 2.092
  },
  {
   "text": "脚落在身体正下方",
   "start": 103.401,
   "dur": 1.55
  },
  {
   "text": "别大步跨出去用脚跟砸地",
   "start": 104.951,
   "dur": 2.62
  },
  {
   "text": "第四",
   "start": 107.571,
   "dur": 0.842
  },
  {
   "text": "每周跑量增加不超过百分之十",
   "start": 108.413,
   "dur": 2.704
  },
  {
   "text": "体重偏大的",
   "start": 111.117,
   "dur": 1.334
  },
  {
   "text": "先用骑车、游泳过渡",
   "start": 112.451,
   "dur": 3.177
  },
  {
   "text": "打球伤胳膊",
   "start": 116.676,
   "dur": 1.274
  },
  {
   "text": "常见原因是只用手臂发力",
   "start": 117.95,
   "dur": 2.799
  },
  {
   "text": "正确的力",
   "start": 120.749,
   "dur": 0.985
  },
  {
   "text": "从脚蹬地开始",
   "start": 121.734,
   "dur": 1.587
  },
  {
   "text": "经过转髋、转体",
   "start": 123.321,
   "dur": 1.935
  },
  {
   "text": "最后才甩到手臂",
   "start": 125.256,
   "dur": 1.815
  },
  {
   "text": "网球肘",
   "start": 127.071,
   "dur": 0.937
  },
  {
   "text": "往往和拍子太重、穿线太紧、握拍太死有关",
   "start": 128.008,
   "dur": 4.363
  },
  {
   "text": "打球前用弹力带激活肩膀和前臂",
   "start": 132.371,
   "dur": 2.873
  },
  {
   "text": "新手先练技术再打比赛",
   "start": 135.244,
   "dur": 2.259
  },
  {
   "text": "球友局里拼抢最容易受伤",
   "start": 137.503,
   "dur": 3.253
  },
  {
   "text": "有一个特别容易被忽略的风险",
   "start": 141.804,
   "dur": 2.151
  },
  {
   "text": "跟腱",
   "start": 143.955,
   "dur": 0.96
  },
  {
   "text": "三四十岁的男性",
   "start": 144.915,
   "dur": 1.394
  },
  {
   "text": "在羽毛球、篮球的急停起跳中跟腱断裂并不少",
   "start": 146.309,
   "dur": 4.399
  },
  {
   "text": "见",
   "start": 150.708,
   "dur": 0.3
  },
  {
   "text": "常常发生在很久没打、一上来就拼的时候",
   "start": 150.708,
   "dur": 3.907
  },
  {
   "text": "预防它",
   "start": 154.615,
   "dur": 0.973
  },
  {
   "text": "热身十分钟",
   "start": 155.588,
   "dur": 1.274
  },
  {
   "text": "平时多练提踵",
   "start": 156.862,
   "dur": 1.286
  },
  {
   "text": "累了就别硬救最后一个球",
   "start": 158.148,
   "dur": 3.128
  },
  {
   "text": "热身不是压腿",
   "start": 162.324,
   "dur": 1.801
  },
  {
   "text": "运动前做动态热身",
   "start": 164.125,
   "dur": 1.719
  },
  {
   "text": "慢跑、开合跳、弓步转体",
   "start": 165.844,
   "dur": 2.668
  },
  {
   "text": "直到微微出汗",
   "start": 168.512,
   "dur": 1.37
  },
  {
   "text": "静态拉伸放在运动后",
   "start": 169.882,
   "dur": 2.056
  },
  {
   "text": "恢复也是训练的一部分",
   "start": 171.938,
   "dur": 1.742
  },
  {
   "text": "睡够七小时",
   "start": 173.68,
   "dur": 1.383
  },
  {
   "text": "蛋白质吃够",
   "start": 175.063,
   "dur": 1.117
  },
  {
   "text": "每公斤体重一点二到一点六克",
   "start": 176.18,
   "dur": 3.264
  },
  {
   "text": "怎么判断该停还是能练？",
   "start": 180.492,
   "dur": 2.462
  },
  {
   "text": "练后肌肉酸是正常的",
   "start": 182.954,
   "dur": 2.236
  },
  {
   "text": "关节疼的话",
   "start": 185.19,
   "dur": 1.178
  },
  {
   "text": "记一个规则",
   "start": 186.368,
   "dur": 1.165
  },
  {
   "text": "疼痛在十分里不超过三分",
   "start": 187.533,
   "dur": 2.476
  },
  {
   "text": "第二天早上不加重",
   "start": 190.009,
   "dur": 1.431
  },
  {
   "text": "可以继续；超过了",
   "start": 191.44,
   "dur": 1.863
  },
  {
   "text": "或者关节肿胀、卡住、打软腿",
   "start": 193.303,
   "dur": 2.908
  },
  {
   "text": "就休息",
   "start": 196.211,
   "dur": 0.854
  },
  {
   "text": "去看运动医学科",
   "start": 197.065,
   "dur": 1.754
  },
  {
   "text": "别吃着止痛药硬撑",
   "start": 198.819,
   "dur": 2.537
  },
  {
   "text": "还有几个容易忽略的场景",
   "start": 202.404,
   "dur": 2.065
  },
  {
   "text": "喝完酒、熬完夜",
   "start": 204.469,
   "dur": 1.731
  },
  {
   "text": "第二天别做剧烈运动",
   "start": 206.2,
   "dur": 1.887
  },
  {
   "text": "高温天和冬天清晨",
   "start": 208.087,
   "dur": 1.887
  },
  {
   "text": "心脏负担更重",
   "start": 209.974,
   "dur": 1.467
  },
  {
   "text": "注意补水和保暖",
   "start": 211.441,
   "dur": 1.851
  },
  {
   "text": "高血压的人",
   "start": 213.292,
   "dur": 1.081
  },
  {
   "text": "举重时别憋气",
   "start": 214.373,
   "dur": 1.707
  },
  {
   "text": "最危险的是周末战士",
   "start": 216.08,
   "dur": 1.971
  },
  {
   "text": "平时不动",
   "start": 218.051,
   "dur": 0.962
  },
  {
   "text": "周末一口气打三小时",
   "start": 219.013,
   "dur": 2.319
  },
  {
   "text": "宁可每周三次",
   "start": 221.332,
   "dur": 1.611
  },
  {
   "text": "每次四十分钟",
   "start": 222.943,
   "dur": 2.269
  },
  {
   "text": "给你一个起步的一周模板",
   "start": 226.26,
   "dur": 1.899
  },
  {
   "text": "周一、周四",
   "start": 228.159,
   "dur": 1.599
  },
  {
   "text": "力量训练四十分钟",
   "start": 229.758,
   "dur": 1.658
  },
  {
   "text": "周二、周六",
   "start": 231.416,
   "dur": 1.491
  },
  {
   "text": "走跑结合三十分钟",
   "start": 232.907,
   "dur": 1.767
  },
  {
   "text": "周日",
   "start": 234.674,
   "dur": 0.793
  },
  {
   "text": "打一场轻松的球",
   "start": 235.467,
   "dur": 1.55
  },
  {
   "text": "以练技术为主",
   "start": 237.017,
   "dur": 1.274
  },
  {
   "text": "其余几天散步、拉伸、睡好觉",
   "start": 238.291,
   "dur": 3.208
  },
  {
   "text": "坚持三个月",
   "start": 241.499,
   "dur": 1.189
  },
  {
   "text": "再根据身体感觉慢慢加量",
   "start": 242.688,
   "dur": 3.284
  },
  {
   "text": "四十岁开始锻炼",
   "start": 247.02,
   "dur": 1.647
  },
  {
   "text": "一点都不晚",
   "start": 248.667,
   "dur": 1.344
  },
  {
   "text": "目标不是练成运动员",
   "start": 250.011,
   "dur": 1.935
  },
  {
   "text": "而是十年、二十年以后",
   "start": 251.946,
   "dur": 2.392
  },
  {
   "text": "依然能跑、能跳、能陪孩子打球",
   "start": 254.338,
   "dur": 3.485
  },
  {
   "text": "慢慢来，反而最快",
   "start": 257.823,
   "dur": 2.717
  }
 ]
}