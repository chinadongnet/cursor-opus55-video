 "captions": [
  {
   "text": "拿到体检单",
   "start": 0.9,
   "dur": 1.338
  },
  {
   "text": "血糖、血脂后面",
   "start": 2.238,
   "dur": 1.887
  },
  {
   "text": "都标着向上的箭头",
   "start": 4.125,
   "dur": 2.087
  },
  {
   "text": "很多六十岁以上的朋友心里一紧",
   "start": 6.212,
   "dur": 3.125
  },
  {
   "text": "是不是从此什么都不能吃了？",
   "start": 9.337,
   "dur": 2.576
  },
  {
   "text": "其实不用慌",
   "start": 11.913,
   "dur": 1.587
  },
  {
   "text": "血糖血脂高",
   "start": 13.5,
   "dur": 1.35
  },
  {
   "text": "是管得住的",
   "start": 14.85,
   "dur": 1.512
  },
  {
   "text": "今天就讲讲",
   "start": 16.362,
   "dur": 1.388
  },
  {
   "text": "六十岁以后",
   "start": 17.75,
   "dur": 1.088
  },
  {
   "text": "怎样健康地生活",
   "start": 18.838,
   "dur": 2.204
  },
  {
   "text": "血糖血脂偏高",
   "start": 22.542,
   "dur": 1.612
  },
  {
   "text": "平时往往没什么感觉",
   "start": 24.154,
   "dur": 2.25
  },
  {
   "text": "真正伤人的",
   "start": 26.404,
   "dur": 1.275
  },
  {
   "text": "是它们悄悄损伤血管",
   "start": 27.679,
   "dur": 2.088
  },
  {
   "text": "让心梗、脑卒中的风险上升",
   "start": 29.767,
   "dur": 3.025
  },
  {
   "text": "好消息是",
   "start": 32.792,
   "dur": 1.138
  },
  {
   "text": "只要把五件事做好",
   "start": 33.93,
   "dur": 1.674
  },
  {
   "text": "吃、动、睡、药、查",
   "start": 35.604,
   "dur": 2.75
  },
  {
   "text": "风险就能明显降下来",
   "start": 38.354,
   "dur": 2.53
  },
  {
   "text": "先说一个容易被忽略的道理",
   "start": 41.984,
   "dur": 2.338
  },
  {
   "text": "老年人控糖",
   "start": 44.322,
   "dur": 1.237
  },
  {
   "text": "不是越低越好",
   "start": 45.559,
   "dur": 1.8
  },
  {
   "text": "身体较好的老人",
   "start": 47.359,
   "dur": 1.7
  },
  {
   "text": "空腹血糖一般控制在四点四到七之间",
   "start": 49.059,
   "dur": 3.65
  },
  {
   "text": "年纪更大、疾病较多的",
   "start": 52.709,
   "dur": 2.263
  },
  {
   "text": "可以适当放宽",
   "start": 54.972,
   "dur": 1.824
  },
  {
   "text": "低血糖会让人头晕、跌倒",
   "start": 56.796,
   "dur": 2.838
  },
  {
   "text": "甚至诱发心脑意外",
   "start": 59.634,
   "dur": 1.738
  },
  {
   "text": "比血糖稍高一点更危险",
   "start": 61.372,
   "dur": 2.75
  },
  {
   "text": "具体目标",
   "start": 64.122,
   "dur": 1.05
  },
  {
   "text": "请和医生商量",
   "start": 65.172,
   "dur": 2.018
  },
  {
   "text": "第一件事：吃",
   "start": 68.29,
   "dur": 2.025
  },
  {
   "text": "记住一个餐盘",
   "start": 70.315,
   "dur": 1.45
  },
  {
   "text": "一半是蔬菜",
   "start": 71.765,
   "dur": 1.313
  },
  {
   "text": "四分之一是主食",
   "start": 73.078,
   "dur": 1.712
  },
  {
   "text": "四分之一是鱼、蛋、豆腐和瘦肉",
   "start": 74.79,
   "dur": 3.55
  },
  {
   "text": "主食里掺些糙米、燕麦和杂豆",
   "start": 78.34,
   "dur": 3.45
  },
  {
   "text": "吃饭的顺序是先吃菜",
   "start": 81.79,
   "dur": 2.25
  },
  {
   "text": "再吃肉",
   "start": 84.04,
   "dur": 0.975
  },
  {
   "text": "最后吃主食",
   "start": 85.015,
   "dur": 1.312
  },
  {
   "text": "餐后血糖会更平稳",
   "start": 86.327,
   "dur": 2.313
  },
  {
   "text": "也别为了降糖饿肚子",
   "start": 88.64,
   "dur": 2.075
  },
  {
   "text": "蛋白质要吃够",
   "start": 90.715,
   "dur": 1.338
  },
  {
   "text": "才能留住肌肉",
   "start": 92.053,
   "dur": 2.043
  },
  {
   "text": "再管住三样东西",
   "start": 95.196,
   "dur": 2.1
  },
  {
   "text": "少油",
   "start": 97.296,
   "dur": 0.912
  },
  {
   "text": "每天烹调油不超过二十五克",
   "start": 98.208,
   "dur": 2.638
  },
  {
   "text": "少吃肥肉、内脏和油炸食品",
   "start": 100.846,
   "dur": 3.238
  },
  {
   "text": "少糖",
   "start": 104.084,
   "dur": 0.899
  },
  {
   "text": "甜饮料、糕点尽量不碰",
   "start": 104.983,
   "dur": 2.801
  },
  {
   "text": "少盐",
   "start": 107.784,
   "dur": 0.949
  },
  {
   "text": "每天不超过五克",
   "start": 108.733,
   "dur": 1.576
  },
  {
   "text": "大约一个啤酒瓶盖",
   "start": 110.309,
   "dur": 1.987
  },
  {
   "text": "水果可以吃",
   "start": 112.296,
   "dur": 1.288
  },
  {
   "text": "放在两餐之间",
   "start": 113.584,
   "dur": 1.437
  },
  {
   "text": "每次一个拳头大小就好",
   "start": 115.021,
   "dur": 2.789
  },
  {
   "text": "第二件事：动",
   "start": 118.91,
   "dur": 1.938
  },
  {
   "text": "每周至少五天",
   "start": 120.848,
   "dur": 1.549
  },
  {
   "text": "每次快走三十分钟左右",
   "start": 122.397,
   "dur": 2.251
  },
  {
   "text": "以微微出汗、还能说话为宜",
   "start": 124.648,
   "dur": 2.962
  },
  {
   "text": "饭后半小时再出门",
   "start": 127.61,
   "dur": 1.95
  },
  {
   "text": "能帮着压住餐后血糖",
   "start": 129.56,
   "dur": 2.375
  },
  {
   "text": "每周再加两三次力量练习",
   "start": 131.935,
   "dur": 2.563
  },
  {
   "text": "比如靠墙静蹲、弹力带",
   "start": 134.498,
   "dur": 2.675
  },
  {
   "text": "留住肌肉",
   "start": 137.173,
   "dur": 1.099
  },
  {
   "text": "就是留住了降糖的发动机",
   "start": 138.272,
   "dur": 2.844
  },
  {
   "text": "运动时，安全第一",
   "start": 142.216,
   "dur": 2.325
  },
  {
   "text": "出门带上几块糖和联系卡",
   "start": 144.541,
   "dur": 2.463
  },
  {
   "text": "穿合脚、防滑的鞋",
   "start": 147.004,
   "dur": 2.037
  },
  {
   "text": "不要空腹运动",
   "start": 149.041,
   "dur": 1.675
  },
  {
   "text": "如果出现胸闷、心慌、出冷汗",
   "start": 150.716,
   "dur": 3.088
  },
  {
   "text": "马上停下休息",
   "start": 153.804,
   "dur": 1.562
  },
  {
   "text": "必要时及时就医",
   "start": 155.366,
   "dur": 2.037
  },
  {
   "text": "每天扶着椅背练练单脚站",
   "start": 157.403,
   "dur": 2.451
  },
  {
   "text": "能锻炼平衡",
   "start": 159.854,
   "dur": 1.324
  },
  {
   "text": "减少跌倒",
   "start": 161.178,
   "dur": 1.804
  },
  {
   "text": "第三件事",
   "start": 164.082,
   "dur": 1.175
  },
  {
   "text": "睡好、心宽、戒烟限酒",
   "start": 165.257,
   "dur": 3.012
  },
  {
   "text": "每晚尽量睡六到八个小时",
   "start": 168.269,
   "dur": 2.325
  },
  {
   "text": "睡不好",
   "start": 170.594,
   "dur": 0.901
  },
  {
   "text": "血糖也容易波动",
   "start": 171.495,
   "dur": 1.925
  },
  {
   "text": "吸烟直接伤血管",
   "start": 173.42,
   "dur": 1.687
  },
  {
   "text": "一定要戒",
   "start": 175.107,
   "dur": 1.05
  },
  {
   "text": "酒最好不喝",
   "start": 176.157,
   "dur": 1.587
  },
  {
   "text": "多和老朋友聊聊天、晒晒太阳",
   "start": 177.744,
   "dur": 2.875
  },
  {
   "text": "心情平和了",
   "start": 180.619,
   "dur": 1.363
  },
  {
   "text": "血糖血压都更稳",
   "start": 181.982,
   "dur": 2.29
  },
  {
   "text": "第四件事",
   "start": 185.372,
   "dur": 1.162
  },
  {
   "text": "药要按时吃",
   "start": 186.534,
   "dur": 1.6
  },
  {
   "text": "降糖药、降脂的他汀类药物",
   "start": 188.134,
   "dur": 3.076
  },
  {
   "text": "是医生根据你的情况开的",
   "start": 191.21,
   "dur": 2.25
  },
  {
   "text": "不能觉得好了就自己停药",
   "start": 193.46,
   "dur": 2.349
  },
  {
   "text": "也别轻信保健品能代替药物",
   "start": 195.809,
   "dur": 3.125
  },
  {
   "text": "有疑问",
   "start": 198.934,
   "dur": 0.888
  },
  {
   "text": "就去问医生",
   "start": 199.822,
   "dur": 1.488
  },
  {
   "text": "吃了药",
   "start": 201.31,
   "dur": 0.9
  },
  {
   "text": "也要继续管住嘴、迈开腿",
   "start": 202.21,
   "dur": 3.016
  },
  {
   "text": "第五件事",
   "start": 206.326,
   "dur": 1.1
  },
  {
   "text": "定期检查",
   "start": 207.426,
   "dur": 1.488
  },
  {
   "text": "家里备一台血糖仪",
   "start": 208.914,
   "dur": 1.762
  },
  {
   "text": "按医生建议测空腹和餐后血糖",
   "start": 210.676,
   "dur": 3.1
  },
  {
   "text": "记在本子上",
   "start": 213.776,
   "dur": 1.538
  },
  {
   "text": "血脂和糖化血红蛋白",
   "start": 215.314,
   "dur": 2.25
  },
  {
   "text": "一般三到六个月查一次",
   "start": 217.564,
   "dur": 2.1
  },
  {
   "text": "每年再查查眼底、肾功能和双脚",
   "start": 219.664,
   "dur": 3.8
  },
  {
   "text": "记住低血糖的信号",
   "start": 223.464,
   "dur": 1.824
  },
  {
   "text": "心慌、手抖、出冷汗",
   "start": 225.288,
   "dur": 2.388
  },
  {
   "text": "马上吃三四块糖",
   "start": 227.676,
   "dur": 2.392
  },
  {
   "text": "把这些串起来",
   "start": 231.168,
   "dur": 1.338
  },
  {
   "text": "一天可以这样过",
   "start": 232.506,
   "dur": 1.45
  },
  {
   "text": "早上七点",
   "start": 233.956,
   "dur": 1.112
  },
  {
   "text": "测血糖、吃早饭",
   "start": 235.068,
   "dur": 1.975
  },
  {
   "text": "饭后半小时",
   "start": 237.043,
   "dur": 1.25
  },
  {
   "text": "出门快走",
   "start": 238.293,
   "dur": 1.125
  },
  {
   "text": "中午吃一份好餐盘",
   "start": 239.418,
   "dur": 1.725
  },
  {
   "text": "再小睡一会儿",
   "start": 241.143,
   "dur": 1.35
  },
  {
   "text": "下午做做力量和平衡练习",
   "start": 242.493,
   "dur": 2.525
  },
  {
   "text": "晚饭清淡，七分饱",
   "start": 245.018,
   "dur": 1.913
  },
  {
   "text": "晚上十点前",
   "start": 246.931,
   "dur": 1.337
  },
  {
   "text": "安心入睡",
   "start": 248.268,
   "dur": 1.698
  },
  {
   "text": "血糖血脂高",
   "start": 251.216,
   "dur": 1.3
  },
  {
   "text": "不是生活的终点",
   "start": 252.516,
   "dur": 1.65
  },
  {
   "text": "而是身体在提醒我们",
   "start": 254.166,
   "dur": 2.225
  },
  {
   "text": "换一种更好的活法",
   "start": 256.391,
   "dur": 2.05
  },
  {
   "text": "吃得对，动起来",
   "start": 258.441,
   "dur": 1.587
  },
  {
   "text": "睡得香，按时吃药",
   "start": 260.028,
   "dur": 1.875
  },
  {
   "text": "定期检查",
   "start": 261.903,
   "dur": 1.488
  },
  {
   "text": "不求一步到位",
   "start": 263.391,
   "dur": 1.338
  },
  {
   "text": "只求天天坚持",
   "start": 264.729,
   "dur": 1.975
  },
  {
   "text": "稳稳当当",
   "start": 266.704,
   "dur": 1.087
  },
  {
   "text": "健康长寿",
   "start": 267.791,
   "dur": 1.815
  }
 ]
}